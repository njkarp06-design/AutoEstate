generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RunStatus {
  IN_PROGRESS
  COMPLETED
}

// The social network a piece of generated listing content targets - distinct
// from Run.source (the messaging channel, WhatsApp/Telegram) the listing
// facts arrived through. Keep these concepts separate; see lib/format.ts.
enum Platform {
  INSTAGRAM
  FACEBOOK
  YAD2
}

// How a customer wants a platform's content handled once generated.
// AUTO_IMMEDIATE/AUTO_AFTER_EDIT are stored preferences only - real
// auto-posting requires a Meta Business-verified app that doesn't exist yet,
// so these currently behave like MANUAL in the UI (labeled "coming soon").
// Facebook/Yad2 have no corresponding field: neither platform's API allows
// third-party posting at all (Meta retired Groups posting in 2024; Yad2 has
// no posting API), so there is no real preference to store for them.
enum PostMode {
  MANUAL
  AUTO_IMMEDIATE
  AUTO_AFTER_EDIT
}

// Lifecycle of a property the customer has advertised through Hermes. Rows
// are matched/created at ingest time from the "Listing Record" footer both
// listing-to-social and listing-status-update append to their replies (see
// lib/listing-record.ts) - not a form the operator fills in.
enum ListingStatus {
  ACTIVE
  UNDER_CONTRACT
  SOLD
}

model Customer {
  id                  String    @id @default(cuid())
  email               String    @unique // set by the operator at onboarding time
  clerkUserId         String?   @unique // backfilled on first login
  displayName         String?
  ingestionSecretHash String    @unique // sha256(secret) - the secret itself is never stored
  instagramPostMode   PostMode  @default(MANUAL)
  createdAt           DateTime  @default(now())
  runs                Run[]
  listings            Listing[]

  @@map("customers")
}

model Run {
  id              String       @id @default(cuid())
  customer        Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId      String
  // Hermes's own session_id - one continuous WhatsApp/Telegram chat thread.
  // NOT unique per listing: Hermes doesn't reset sessions between messages
  // (session_reset: mode: none), so an agent sending several listings in one
  // sitting shares one session_id across all of them. Kept for reference,
  // not used for grouping.
  hermesSessionId String
  // Hermes's own turn_id - unique per conversational turn. This is the
  // actual grouping key: one Run per turn, not per session. A listing that
  // needs a follow-up question spans two turns/two Run rows rather than
  // being merged into whatever session it happens to share with unrelated
  // earlier or later listings.
  hermesTurnId    String
  source          String // "whatsapp" | "telegram"
  displayName     String?
  startedAt       DateTime
  title           String?
  status          RunStatus            @default(IN_PROGRESS)
  messages        RunMessage[]
  platformContent RunPlatformContent[]
  // Set at ingest time when exactly one Listing Record footer is parsed from
  // this turn's reply. Left null when a turn's reply legitimately mixes two
  // distinguishable listings (see ingest route) - a single FK can't
  // represent "this turn touched two listings", but both Listing rows are
  // still correctly created/updated regardless.
  listing         Listing?             @relation(fields: [listingId], references: [id], onDelete: SetNull)
  listingId       String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@unique([customerId, hermesTurnId])
  @@index([customerId, startedAt])
  @@map("runs")
}

model RunMessage {
  id        String   @id @default(cuid())
  run       Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  runId     String
  role      String // "user" | "assistant"
  content   String   @db.Text
  timestamp DateTime
  sortIndex Int      @default(0) // disambiguates ordering when timestamps collide

  @@unique([runId, role, sortIndex])
  @@index([runId, timestamp, sortIndex])
  @@map("run_messages")
}

// App-owned per-platform state Hermes doesn't know about: an operator's edit
// override and whether they've actually posted it. Created lazily (upserted
// on first edit/mark-posted action) - most runs will have 0-3 rows, never
// created eagerly by the ingest route.
model RunPlatformContent {
  id            String    @id @default(cuid())
  run           Run       @relation(fields: [runId], references: [id], onDelete: Cascade)
  runId         String
  platform      Platform
  editedContent String?   @db.Text // null = show Hermes's original parsed text
  posted        Boolean   @default(false)
  postedAt      DateTime?
  updatedAt     DateTime  @updatedAt

  @@unique([runId, platform])
  @@map("run_platform_content")
}

// One row per property the customer has ever advertised through Hermes.
// Matched/created at ingest time (see app/api/ingest/route.ts) by parsing the
// "Listing Record" footer both listing-to-social and listing-status-update
// append to their replies - not a form the operator fills in (no edit UI in
// this pass; see app/listings).
model Listing {
  id              String        @id @default(cuid())
  customer        Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId      String
  area            String
  // "sale" | "rental" normalized where recognizable, else the raw trimmed
  // footer text - kept as a plain string rather than an enum, same
  // rationale as Run.source: this value is parsed from a skill's free-text
  // footer, and an unrecognized value must never hard-fail ingest the way an
  // invalid Postgres enum value would.
  transactionType String
  rooms           Float         // supports Israeli half-room listings, e.g. 3.5
  sqm             Float
  floor           Int?
  // Nullable: listing-status-update's sold/under-contract announcements may
  // omit price entirely. A null price on update leaves the existing price
  // untouched; a null price on create shows as unknown rather than a
  // fabricated 0.
  price           Int?
  status          ListingStatus @default(ACTIVE)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  runs            Run[]

  @@index([customerId, status])
  @@map("listings")
}
