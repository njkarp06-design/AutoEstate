generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RunStatus {
  IN_PROGRESS
  COMPLETED
}

// The social network a piece of generated listing content targets - distinct
// from Run.source (the messaging channel, WhatsApp/Telegram) the listing
// facts arrived through. Keep these concepts separate; see lib/format.ts.
enum Platform {
  INSTAGRAM
  FACEBOOK
  YAD2
}

// How a customer wants a platform's content handled once generated.
// AUTO_IMMEDIATE/AUTO_AFTER_EDIT are stored preferences only - real
// auto-posting requires a Meta Business-verified app that doesn't exist yet,
// so these currently behave like MANUAL in the UI (labeled "coming soon").
// Facebook/Yad2 have no corresponding field: neither platform's API allows
// third-party posting at all (Meta retired Groups posting in 2024; Yad2 has
// no posting API), so there is no real preference to store for them.
enum PostMode {
  MANUAL
  AUTO_IMMEDIATE
  AUTO_AFTER_EDIT
}

// Lifecycle of a property the customer has advertised through Hermes. Rows
// are matched/created at ingest time from the "Listing Record" footer that
// listing-to-social, listing-status-update and just-sold append to their
// replies (see lib/listing-record.ts) - not a form the operator fills in.
// just-sold is the only skill that ever writes SOLD; listing-reengagement
// deliberately emits no footer, since nothing about the listing transitions.
enum ListingStatus {
  ACTIVE
  UNDER_CONTRACT
  SOLD
}

// A buyer inquiry's handling state. Unlike RunStatus (which tracks whether
// Hermes finished generating), this tracks whether the human OPERATOR still
// needs to act: every inquiry is auto-answered by the buyer bot, but a lead
// that asked for a viewing / made an offer / hit a non-ACTIVE listing needs a
// person. Defaults to NEEDS_OPERATOR; the operator marks it HANDLED from the
// dashboard. (The per-message "does this reply defer to a human?" signal is
// computed display-only in lib/inquiries.ts, not stored - see the buyer-inquiry
// skill's canonical defer sentence, which that heuristic keys on.)
enum InquiryStatus {
  NEEDS_OPERATOR
  HANDLED
}

// Two machine credentials per customer, deliberately NOT one.
//
// Every route a Hermes instance calls authenticates with a per-customer bearer
// secret, and the lookup is scoped to the calling ROLE's column (see
// lib/ingest-auth.ts) - so a secret is only ever valid on its own role's
// routes, and a route cannot authenticate the wrong role even by mistake.
//
// The split exists because the BUYER instance is the only surface untrusted
// people can reach. While both roles shared one secret, a compromise of that
// public box carried write access to POST /api/ingest - the ability to create
// and mutate Listing rows on the customer's real data, including flipping a
// property to SOLD. The tool lockdown on that instance does nothing about it:
// it constrains what the agent can do, not what the credential is allowed to
// reach.
//
//   operatorSecretHash -> POST /api/ingest, GET /api/listings/active
//   buyerSecretHash    -> POST /api/inquiries, GET /api/listings/buyer-view
//
// buyerSecretHash is nullable - a customer has one only once a buyer instance
// is provisioned for them. Postgres allows many NULLs in a unique column,
// which is what makes that work.
model Customer {
  id                  String    @id @default(cuid())
  email               String    @unique // set by the operator at onboarding time
  clerkUserId         String?   @unique // backfilled on first login
  displayName         String?
  operatorSecretHash  String    @unique // sha256(secret) - the secret itself is never stored
  buyerSecretHash     String?   @unique // sha256(secret); null until a buyer instance exists
  instagramPostMode   PostMode  @default(MANUAL)
  // Where this customer's "a buyer needs you" lead alerts are pushed. The app
  // sends via one shared notifier bot (OPERATOR_TELEGRAM_BOT_TOKEN env); this
  // is the per-customer destination chat. Null = no push (the lead still shows
  // in the dashboard). Set by the customer on the Settings page.
  operatorTelegramChatId String?
  createdAt           DateTime  @default(now())
  runs                Run[]
  listings            Listing[]
  inquiries           Inquiry[]

  @@map("customers")
}

model Run {
  id              String       @id @default(cuid())
  customer        Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId      String
  // Hermes's own session_id - one continuous WhatsApp/Telegram chat thread.
  // NOT unique per listing: Hermes doesn't reset sessions between messages
  // (session_reset: mode: none), so an agent sending several listings in one
  // sitting shares one session_id across all of them. Kept for reference,
  // not used for grouping.
  hermesSessionId String
  // Hermes's own turn_id - unique per conversational turn. This is the
  // actual grouping key: one Run per turn, not per session. A listing that
  // needs a follow-up question spans two turns/two Run rows rather than
  // being merged into whatever session it happens to share with unrelated
  // earlier or later listings.
  hermesTurnId    String
  source          String // "whatsapp" | "whatsapp_cloud" | "telegram"
  displayName     String?
  startedAt       DateTime
  title           String?
  status          RunStatus            @default(IN_PROGRESS)
  messages        RunMessage[]
  platformContent RunPlatformContent[]
  // Set at ingest time when exactly one Listing Record footer is parsed from
  // this turn's reply. Left null when a turn's reply legitimately mixes two
  // distinguishable listings (see ingest route) - a single FK can't
  // represent "this turn touched two listings", but both Listing rows are
  // still correctly created/updated regardless.
  listing         Listing?             @relation(fields: [listingId], references: [id], onDelete: SetNull)
  listingId       String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@unique([customerId, hermesTurnId])
  @@index([customerId, startedAt])
  @@map("runs")
}

model RunMessage {
  id        String   @id @default(cuid())
  run       Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  runId     String
  role      String // "user" | "assistant"
  content   String   @db.Text
  timestamp DateTime
  sortIndex Int      @default(0) // disambiguates ordering when timestamps collide

  @@unique([runId, role, sortIndex])
  @@index([runId, timestamp, sortIndex])
  @@map("run_messages")
}

// App-owned per-platform state Hermes doesn't know about: an operator's edit
// override and whether they've actually posted it. Created lazily (upserted
// on first edit/mark-posted action) - most runs will have 0-3 rows, never
// created eagerly by the ingest route.
model RunPlatformContent {
  id            String    @id @default(cuid())
  run           Run       @relation(fields: [runId], references: [id], onDelete: Cascade)
  runId         String
  platform      Platform
  editedContent String?   @db.Text // null = show Hermes's original parsed text
  posted        Boolean   @default(false)
  postedAt      DateTime?
  updatedAt     DateTime  @updatedAt

  @@unique([runId, platform])
  @@map("run_platform_content")
}

// One row per property the customer has ever advertised through Hermes.
// Matched/created at ingest time (see app/api/ingest/route.ts) by parsing the
// "Listing Record" footer that listing-to-social, listing-status-update and
// just-sold append to their replies - not a form the operator fills in (no
// edit UI in this pass; see app/listings).
model Listing {
  id              String        @id @default(cuid())
  customer        Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId      String
  area            String
  // "sale" | "rental" normalized where recognizable, else the raw trimmed
  // footer text - kept as a plain string rather than an enum, same
  // rationale as Run.source: this value is parsed from a skill's free-text
  // footer, and an unrecognized value must never hard-fail ingest the way an
  // invalid Postgres enum value would.
  transactionType String
  rooms           Float         // supports Israeli half-room listings, e.g. 3.5
  sqm             Float
  floor           Int?
  // Nullable: listing-status-update's sold/under-contract announcements may
  // omit price entirely. A null price on update leaves the existing price
  // untouched; a null price on create shows as unknown rather than a
  // fabricated 0.
  price           Int?
  status          ListingStatus @default(ACTIVE)
  // Free-text amenities the agent actually stated ("elevator, balcony,
  // parking"), parsed from the Listing Record footer's last line. Nullable and
  // free text for the same reason as transactionType: it comes from a skill's
  // free-text output and an unexpected value must never hard-fail ingest.
  //
  // Null for every listing created before 2026-07-28, and for any footer that
  // omits the line - normal, not malformed. NOT part of the ingest match key
  // (customerId, area, rooms, sqm): editing a feature must update the listing,
  // never create a second one.
  features        String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  runs            Run[]
  inquiries       Inquiry[]

  @@index([customerId, status])
  @@map("listings")
}

// One buyer conversation — an inbound thread from a prospective buyer/renter
// (a stranger) with the customer's dedicated, locked-down buyer instance. The
// inbound counterpart to Run: Run holds the operator's outbound content
// generation; Inquiry holds a buyer's questions and the bot's answers.
//
// Thread key is the Hermes SESSION, not the turn (the opposite of Run, which
// keys on the turn to keep unrelated back-to-back listings separate). A buyer
// conversation is a genuine multi-turn back-and-forth we WANT kept together as
// one lead, and on the isolated buyer instance one session is one buyer — so
// each turn appends an InquiryMessage rather than starting a new Inquiry.
//
// "One session is one buyer" is verified, not assumed. It was the open risk
// this key was chosen under, with a fallback to a resolved `sender` handle
// held in reserve; the fallback is no longer needed. Two real senders in the
// 2026-07-25 Telegram spike produced two sessions keyed
// agent:main:telegram:dm:<user_id>, and the 2026-07-26 live test with a
// genuine non-operator account produced two separate Inquiry rows with no
// bleed. Re-check this if the buyer channel ever moves to a transport whose
// session key isn't per-sender.
model Inquiry {
  id              String           @id @default(cuid())
  customer        Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId      String
  hermesSessionId String
  // Best human-reachable contact for the buyer, resolved best-effort by the
  // sync-inquiries-to-webapp plugin (Phase-0b). THE #1 lead field: a lead you
  // can't reach is worthless. Null when nothing reachable could be captured
  // (e.g. a WhatsApp LID with no dialable number) — the UI then shows
  // "contact not captured" rather than a fabricated value.
  buyerContact    String?
  // Set when the bot's answers in this thread pinned the inquiry to exactly
  // one listing (best-effort, at ingest time). SetNull so deleting a listing
  // never deletes the lead.
  listing         Listing?         @relation(fields: [listingId], references: [id], onDelete: SetNull)
  listingId       String?
  source          String // "whatsapp" | "whatsapp_cloud" | "telegram"
  status          InquiryStatus    @default(NEEDS_OPERATOR)
  title           String?
  startedAt       DateTime
  messages        InquiryMessage[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([customerId, hermesSessionId])
  @@index([customerId, startedAt])
  @@map("inquiries")
}

model InquiryMessage {
  id           String   @id @default(cuid())
  inquiry      Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  inquiryId    String
  // Hermes's own turn_id. Dedup is on the turn + role, NOT a computed row
  // index: a retried sync POST for the same turn can't double-insert, and
  // there's no count()-based race under concurrent turns (see the buyer plan).
  hermesTurnId String
  role         String // "user" | "assistant"
  content      String   @db.Text
  timestamp    DateTime
  sortIndex    Int      @default(0) // display order only

  @@unique([inquiryId, hermesTurnId, role])
  @@index([inquiryId, timestamp, sortIndex])
  @@map("inquiry_messages")
}
