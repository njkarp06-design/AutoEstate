generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RunStatus {
  IN_PROGRESS
  COMPLETED
}

model Customer {
  id                  String   @id @default(cuid())
  email               String   @unique // set by the operator at onboarding time
  clerkUserId         String?  @unique // backfilled on first login
  displayName         String?
  ingestionSecretHash String   @unique // sha256(secret) - the secret itself is never stored
  createdAt           DateTime @default(now())
  runs                Run[]

  @@map("customers")
}

model Run {
  id               String       @id @default(cuid())
  customer         Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId       String
  hermesSessionId  String // Hermes's own session_id - not a global PK across instances
  source           String // "whatsapp" | "telegram"
  displayName      String?
  startedAt        DateTime
  title            String?
  status           RunStatus    @default(IN_PROGRESS)
  estimatedCostUsd Decimal?     @db.Decimal(10, 4)
  messages         RunMessage[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([customerId, hermesSessionId])
  @@index([customerId, startedAt])
  @@map("runs")
}

model RunMessage {
  id        String   @id @default(cuid())
  run       Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  runId     String
  role      String // "user" | "assistant"
  content   String   @db.Text
  timestamp DateTime
  sortIndex Int      @default(0) // disambiguates ordering when timestamps collide

  @@index([runId, timestamp, sortIndex])
  @@map("run_messages")
}
