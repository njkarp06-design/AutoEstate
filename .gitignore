# Secrets — never committed
.env*
# ...except value-stripped profile templates. These document which env vars a
# Hermes instance needs (and why) and are checked before every commit to be
# sure no real value is present. Named narrowly so a stray `.env` can never
# match this negation.
!agent/profiles/*/.env.example

# Hermes local state (credentials, memory, logs — lives outside the repo by default,
# ignored here defensively in case HERMES_HOME ever points into the project)
.hermes/

# Node
node_modules/
.next/
out/

# Python
__pycache__/
*.pyc

# OS / editor
.DS_Store
Thumbs.db

# Local Claude Code tooling state — everything under .claude/ stays local.
#
# The `!.claude/settings.json` negation below is a deliberate leftover, not an
# active rule: that file held a doc-sync hook and was deleted on 2026-07-26
# (see CLAUDE.md §3). It now just permits a file that does not exist. Kept
# rather than swept up with the deletion, so re-adding a tracked settings.json
# needs no .gitignore change.
#
# The pattern must be `.claude/*` rather than `.claude/` — git does not descend
# into an excluded directory, so a negation under a `.claude/` rule would never
# match.
.claude/*
!.claude/settings.json
# Personal per-machine overrides stay ignored.
.claude/settings.local.json
