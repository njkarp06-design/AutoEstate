# Secrets — never committed
.env*

# Hermes local state (credentials, memory, logs — lives outside the repo by default,
# ignored here defensively in case HERMES_HOME ever points into the project)
.hermes/

# Node
node_modules/
.next/
out/

# Python
__pycache__/
*.pyc

# OS / editor
.DS_Store
Thumbs.db

# Local Claude Code tooling state.
# Everything under .claude/ stays local EXCEPT the shared doc-sync tooling —
# settings.json (the hooks) and doc-consistency-check.sh (the background checker
# the Stop hook invokes) — which are meant to be version-controlled. Note the
# pattern must be `.claude/*` rather than `.claude/` — git does not descend into
# an excluded directory, so a negation under a `.claude/` rule would never match.
.claude/*
!.claude/settings.json
!.claude/doc-consistency-check.sh
# Personal per-machine overrides stay ignored.
.claude/settings.local.json
# Transient output of the background checker: a scratch note to action and
# delete, not a record worth versioning.
.claude/doc-findings.md
.claude/doc-check.log
.claude/.doc-check-stamp
