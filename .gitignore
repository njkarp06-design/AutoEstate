# Secrets — never committed
.env*

# Hermes local state (credentials, memory, logs — lives outside the repo by default,
# ignored here defensively in case HERMES_HOME ever points into the project)
.hermes/

# Node
node_modules/
.next/
out/

# Python
__pycache__/
*.pyc

# OS / editor
.DS_Store
Thumbs.db

# Local Claude Code tooling state.
# Everything under .claude/ stays local EXCEPT doc-consistency-check.sh, the
# on-demand pre-PR doc checker, which is the one file this branch exists to
# carry. NOTE the pattern must be `.claude/*` rather than `.claude/` — git does
# not descend into an excluded directory, so a negation under a `.claude/` rule
# would never match.
#
# There is deliberately no `!.claude/settings.json` negation: that file held
# hooks, all hooks were removed from this repo on 2026-07-26, and it was
# deleted from this branch on 2026-07-27. The checker is run by hand, not by a
# hook. Do not re-add it.
.claude/*
!.claude/doc-consistency-check.sh
# Personal per-machine overrides stay ignored.
.claude/settings.local.json
# Transient output of the checker: a scratch note to action and delete, plus
# its log and the run stamp and lock it manages itself.
.claude/doc-findings.md
.claude/doc-check.log
.claude/.doc-check-stamp
.claude/.doc-check-lock/
