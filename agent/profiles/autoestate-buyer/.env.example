# AutoEstate — BUYER-FACING instance (dev). Per-profile secrets.
# This instance is public: strangers message it. Keep this file owner-only.

# --- Model ---------------------------------------------------------------
ANTHROPIC_API_KEY=

# --- Telegram (the Facebook-sourced buyer channel) ------------------------
# Dedicated dev bot, separate from the operator bot and from the revoked
# 2026-07-25 spike bot.
TELEGRAM_BOT_TOKEN=

# Explicit allow-all. Proven by the 2026-07-25 spike: an EMPTY value passes
# the adapter's intake prefilter but then routes unknown DMs into a PAIRING
# flow, which a stranger would never complete. `*` skips pairing entirely,
# which is the whole point of a public receptionist.
TELEGRAM_ALLOWED_USERS=*

# --- WhatsApp (the Yad2 / Instagram-sourced buyer channel) ----------------
# COMMENTED OUT ON PURPOSE. Uncomment all three ONLY once a dedicated second
# number is actually paired (see the profile README for the pairing steps).
#
# Why commented rather than set to false: WHATSAPP_ENABLED=false does NOT stop
# Hermes attempting a connection - a known Hermes behaviour this project has
# already been bitten by, which is why the personal `default` profile comments
# its WhatsApp vars out too. A half-configured WhatsApp is messier than an
# absent one.
#
# CORRECTED 2026-07-29 - commenting them out does NOT stop it either, so do not
# treat this as a kill switch. Measured by resolving load_gateway_config() on
# both profiles with the value in the real process environment: WhatsApp is
# enabled:True with the var absent, =false, and =true alike. Only the absence of
# a pairing (creds.json) actually keeps the adapter off the network. Commenting
# is for tidiness, and it has a real cost: `hermes whatsapp` treats a profile
# whose WHATSAPP_* values it cannot see as a FIRST-TIME setup and re-asks who
# may message the bot, overwriting the allowlist with whatever is typed.
#
# The number must be a DEDICATED second line, never the operator's and never a
# personal one. This bot is public: a ban takes that number's WhatsApp with it.
#
# WHATSAPP_ENABLED=true
#
# MUST be `bot`. The adapter defaults to `self-chat`, which runs the agent on
# the operator's OWN number talking to itself - wrong for a public
# receptionist, and a mode this project explicitly ruled out because it puts
# the ban risk on the very number we are protecting.
# WHATSAPP_MODE=bot
#
# Explicit allow-all, same reasoning as Telegram above but the OPPOSITE
# default: on WhatsApp an EMPTY value means NOBODY (matchesAllowedUser returns
# false on an empty set - a deliberate secure default upstream), so leaving it
# blank yields a bot that silently answers no one. `*` is the documented way to
# run an open bot.
# WHATSAPP_ALLOWED_USERS=*

# --- REQUIRED, and NOT commented out like the three above ------------------
# Without this the gateway REFUSES TO START - not "WhatsApp fails to connect",
# the whole process aborts:
#
#   Refusing to start: whatsapp has dm_policy/group_policy set to 'open' but
#   neither GATEWAY_ALLOW_ALL_USERS nor WHATSAPP_ALLOW_ALL_USERS is enabled
#
# config.yaml sets platforms.whatsapp.extra.dm_policy: open (a public
# receptionist must answer strangers directly), and Hermes treats open policy as
# needing a SECOND, explicit opt-in on top of the allowlist -
# gateway/run.py::_own_policy_open_startup_violation. An allowlist of `*` is
# deliberately not sufficient. That is good design: it fails closed, refusing to
# run rather than quietly serving the public.
#
# It applies even while the three WHATSAPP_* vars above are still commented out,
# because WhatsApp resolves `enabled: True` regardless of them (measured
# 2026-07-29 - see the note at the end of this file). Verified by resolving
# _own_policy_open_startup_violation against this profile's real config with
# this var removed: `whatsapp: open policy without allow-all opt-in`.
#
# Platform-scoped ON PURPOSE. GATEWAY_ALLOW_ALL_USERS would open EVERY platform
# at once, which is a much bigger grant than intended.
WHATSAPP_ALLOW_ALL_USERS=true

# --- Home channels: suppress the one-time /sethome prompt -----------------
# REQUIRED on a public bot. Without these, every buyer's FIRST message is
# answered with "📬 No home channel is set … Type /sethome to make this chat
# your home channel." It fires whenever a session has no history, so on a
# public instance that is every new prospect, as their first impression.
# Found by a live buyer test on 2026-07-28.
#
# The value is where cron / cross-platform output is delivered. Point it at
# the OPERATOR, never a buyer chat, so nothing internal is ever addressed to
# a stranger. WhatsApp wants the operator's LID, Telegram their user id.
WHATSAPP_HOME_CHANNEL=
TELEGRAM_HOME_CHANNEL=

# --- Reporting app -------------------------------------------------------
# Both buyer plugins derive their endpoints from this one URL:
#   buyer-listings-context  -> /api/listings/buyer-view
#   sync-inquiries-to-webapp -> /api/inquiries
AUTOESTATE_INGESTION_URL=http://127.0.0.1:4127/api/ingest
# This instance's OWN secret — NOT the operator instance's.
#
# The two are separate credentials, and the reporting app scopes each one to
# its own routes (see reporting-app/lib/ingest-auth.ts). This value is valid
# ONLY on /api/inquiries and /api/listings/buyer-view; presenting it to
# /api/ingest returns 401. That matters because this box is public: while the
# two roles shared one secret, extracting it from here meant write access to
# the customer's Listing data, up to flipping a property to SOLD.
#
# Mint and register one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   echo <secret> | npx tsx scripts/provision-customer.ts <email> --role buyer
# then put the same value here. The customer must already exist (its operator
# credential is registered first).
AUTOESTATE_INGESTION_SECRET=

# NOTE: the former "no WHATSAPP_* vars at all" rule was retired on 2026-07-28
# when WhatsApp became a real second buyer channel. Its rationale - never
# contend with the operator profile's paired device - is now satisfied
# structurally: a separate number, a separate (profile-scoped) session dir and
# a separate bridge port (3001, set in config.yaml). Nothing is left to contend
# over. The vars above still ship commented out until a number is paired.
